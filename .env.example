# ============================================================================
# JARVIS PERSONAL AI — environment variables
#
# JARVIS has NO .env loader and sends nothing anywhere: these are ordinary
# process environment variables, read only by jarvis/config/loader.py.
# Set them in your shell before launching, for example:
#
#   PowerShell :  $env:JARVIS_MODEL = "qwen2.5:3b"
#   cmd.exe    :  set JARVIS_MODEL=qwen2.5:3b
#   bash/zsh   :  export JARVIS_MODEL=qwen2.5:3b
#
# Copy the lines you need into your shell profile (or a local .env that your
# own launcher sources). Nothing here is a secret, and no API key is required
# because JARVIS never talks to a cloud model.
# ============================================================================

# Directory holding config.yaml, memory, voices, logs, workspace and screenshots.
# Default: %USERPROFILE%\.jarvis  (Linux/macOS: ~/.jarvis)
# Equivalent CLI flag: --data-dir <path>
# JARVIS_DATA_DIR=

# Local Ollama endpoint. Must be a loopback address (127.0.0.1 / localhost / ::1);
# non-loopback values are rejected at startup on purpose.
# Default: http://127.0.0.1:11434
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# Preferred local Ollama model. Empty/absent = auto-select the best installed
# model that fits the 6 GB VRAM budget.
# Equivalent CLI flag: --model <name>
# JARVIS_MODEL=qwen2.5:7b

# --- test / CI only ---------------------------------------------------------
# Force Qt to run headless when PySide6 is installed (GUI tests never open a window).
# QT_QPA_PLATFORM=offscreen
